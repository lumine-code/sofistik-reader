  "main": "./lib/index",
  "files": [
    "binding.gyp",
    "lib",
    "scripts",
    "spec",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp rebuild",
