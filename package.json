    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "jasmine": "^7.0.0",
    "node-gyp": "^13.1.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
